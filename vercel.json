{
  "builds": [
    {
      "src": "src/stayline/app/api.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "data/warehouse/stayline.db",
          "config/settings.yaml",
          "config/assumptions.yaml",
          "app/index.html"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/stayline/app/api.py"
    },
    {
      "src": "/(.*)",
      "dest": "src/stayline/app/api.py"
    }
  ]
}
